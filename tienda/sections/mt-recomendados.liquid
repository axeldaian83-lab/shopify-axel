{{ 'mt-styles.css' | asset_url | stylesheet_tag }}

{%- assign mt_collection = section.settings.coleccion -%}
{%- assign mt_count = 0 -%}
{%- if mt_collection != blank -%}
  {%- for p in mt_collection.products -%}
    {%- unless p.id == product.id -%}
      {%- assign mt_count = mt_count | plus: 1 -%}
    {%- endunless -%}
  {%- endfor -%}
{%- endif -%}

{%- if mt_count > 0 -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      background: var(--mt-color-bg);
    }
    #shopify-section-{{ section.id }} .mt-tendencia__grid {
      grid-template-columns: repeat({{ section.settings.columnas }}, 1fr);
    }
  {% endstyle %}

  <section class="mt-section mt-tendencia">
    <div class="mt-container">
      <div class="mt-tendencia__head mt-reveal">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="mt-eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="mt-h2" style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.headline }}</h2>
        </div>
      </div>

      <div class="mt-tendencia__grid mt-reveal mt-reveal-stagger">
        {%- assign mt_shown = 0 -%}
        {%- for p in mt_collection.products -%}
          {%- unless p.id == product.id -%}
            {%- if mt_shown < section.settings.cantidad -%}
              <a href="{{ p.url }}" class="mt-tendencia__card">
                <div class="mt-tendencia__img">
                  {%- if p.featured_image != blank -%}
                    <img src="{{ p.featured_image | image_url: width: 600 }}" alt="{{ p.featured_image.alt | escape }}" loading="lazy" width="600" height="600">
                  {%- else -%}
                    <div class="mt-img-placeholder">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                    </div>
                  {%- endif -%}
                </div>
                <div class="mt-tendencia__info">
                  <p class="mt-tendencia__name">{{ p.title }}</p>
                  <p class="mt-tendencia__price">{{ p.price | money }}</p>
                </div>
              </a>
              {%- assign mt_shown = mt_shown | plus: 1 -%}
            {%- endif -%}
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "MT – Recomendados",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "También te puede interesar" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Más de nuestra tienda" },
    { "type": "collection", "id": "coleccion", "label": "Colección de la que recomendar" },
    { "type": "range", "id": "cantidad", "label": "Número de productos", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columnas", "label": "Columnas en escritorio", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 22, "max": 56, "step": 2, "unit": "px", "default": 36 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 }
  ],
  "presets": [ { "name": "MT – Recomendados" } ]
}
{% endschema %}
