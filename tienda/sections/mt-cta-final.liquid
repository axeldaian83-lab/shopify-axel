{{ 'mt-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--mt-color-bg-dark);
  }
{% endstyle %}

<section class="mt-section mt-section--dark mt-cta-final">
  <div class="mt-container mt-cta-final__inner mt-reveal">
    <h2 class="mt-h2" style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.headline }}</h2>
    <p class="mt-body" style="margin-top:16px;">{{ section.settings.body }}</p>
    <div class="mt-cta-final__ctas">
      <a href="{{ section.settings.button_link | default: '#' }}" class="mt-btn">{{ section.settings.button_text }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – CTA final",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "headline", "label": "Título", "default": "Don't miss out on the trend" },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Shipping to the United States, Canada and Mexico. Buy today and get it at your door." },
    { "type": "text", "id": "button_text", "label": "Texto del botón", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 24, "max": 60, "step": 2, "unit": "px", "default": 42 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "MT – CTA final" } ]
}
{% endschema %}
