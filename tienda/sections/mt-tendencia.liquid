{{ 'mt-styles.css' | asset_url | stylesheet_tag }}

{%- assign mt_collection = section.settings.coleccion -%}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--mt-color-bg);
  }
  #shopify-section-{{ section.id }} .mt-tendencia__grid {
    grid-template-columns: repeat({{ section.settings.columnas }}, 1fr);
  }
{% endstyle %}

<section class="mt-section mt-tendencia">
  <div class="mt-container">
    <div class="mt-tendencia__head mt-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="mt-eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="mt-h2" style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.headline }}</h2>
      </div>
      {%- if mt_collection != blank -%}
        <a href="{{ mt_collection.url }}" class="mt-btn mt-btn--ghost">{{ section.settings.link_text }}</a>
      {%- endif -%}
    </div>

    <div class="mt-tendencia__grid mt-reveal mt-reveal-stagger">
      {%- if mt_collection != blank and mt_collection.products.size > 0 -%}
        {%- for product in mt_collection.products limit: section.settings.cantidad -%}
          <a href="{{ product.url }}" class="mt-tendencia__card">
            <div class="mt-tendencia__img">
              {%- if product.featured_image != blank -%}
                <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="600" height="600">
              {%- else -%}
                <div class="mt-img-placeholder">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                </div>
              {%- endif -%}
            </div>
            <div class="mt-tendencia__info">
              <p class="mt-tendencia__name">{{ product.title }}</p>
              <p class="mt-tendencia__price">{{ product.price | money }}</p>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <div class="mt-tendencia__empty">
          <p>{{ section.settings.texto_vacio }}</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – Tendencia",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "This week" },
    { "type": "text", "id": "headline", "label": "Título", "default": "What everyone is buying right now" },
    { "type": "text", "id": "link_text", "label": "Texto del enlace a la colección", "default": "Shop all" },
    { "type": "collection", "id": "coleccion", "label": "Colección a mostrar" },
    { "type": "range", "id": "cantidad", "label": "Número de productos", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columnas", "label": "Columnas en escritorio", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "textarea", "id": "texto_vacio", "label": "Texto cuando aún no hay productos", "default": "Trending products are landing here very soon. Choose a collection from the editor once your catalog is ready." },
    { "type": "header", "content": "Tipografía" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 22, "max": 56, "step": 2, "unit": "px", "default": 36 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "presets": [ { "name": "MT – Tendencia" } ]
}
{% endschema %}
