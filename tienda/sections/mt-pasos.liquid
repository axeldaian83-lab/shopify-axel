{{ 'mt-styles.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--mt-color-bg);
  }
{% endstyle %}

<section class="mt-section mt-pasos">
  <div class="mt-container">
    <div class="mt-tendencia__head mt-reveal" style="justify-content:center;text-align:center;flex-direction:column;align-items:center;">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mt-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="mt-h2" style="font-size:{{ section.settings.heading_size }}px;">{{ section.settings.headline }}</h2>
    </div>

    <div class="mt-pasos__grid mt-reveal mt-reveal-stagger">
      {%- for block in section.blocks -%}
        <div class="mt-pasos__card" {{ block.shopify_attributes }}>
          <span class="mt-pasos__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="mt-pasos__title">{{ block.settings.titulo }}</h3>
          <p class="mt-body">{{ block.settings.texto }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – Pasos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "How it works" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Order in 3 steps, delivered to your door" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 22, "max": 56, "step": 2, "unit": "px", "default": 36 },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título del paso", "default": "Place your order" },
        { "type": "textarea", "id": "texto", "label": "Descripción", "default": "Pick your favorite product and pay securely in under a minute." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MT – Pasos",
      "blocks": [
        { "type": "paso", "settings": { "titulo": "Haz tu pedido", "texto": "Elige tu producto favorito y paga de forma segura en menos de 1 minuto." } },
        { "type": "paso", "settings": { "titulo": "Lo preparamos y enviamos", "texto": "Procesamos tu pedido rápido y te avisamos en cuanto sale hacia EE.UU., Canadá o México." } },
        { "type": "paso", "settings": { "titulo": "Disfrútalo en tu puerta", "texto": "Recíbelo en casa y descubre por qué todos hablan de este producto." } }
      ]
    }
  ]
}
{% endschema %}
