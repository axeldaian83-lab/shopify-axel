{{ 'mt-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mt-scripts.js' | asset_url }}" defer></script>
<script src="{{ 'mt-producto.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--mt-color-bg);
  }
{% endstyle %}

<section class="mt-section mt-producto">
  <div class="mt-container mt-producto__grid">

    <div class="mt-producto__galeria">
      <div class="mt-producto__img-principal" data-mt-main-media>
        {%- if product.featured_media != blank -%}
          <img
            src="{{ product.featured_media | image_url: width: 1200 }}"
            alt="{{ product.featured_media.alt | escape }}"
            id="mt-main-image"
            loading="eager" fetchpriority="high"
            width="{{ product.featured_media.width }}" height="{{ product.featured_media.height }}">
        {%- else -%}
          <div class="mt-img-placeholder" id="mt-main-image">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
            <span>Upload your product photos from the catalog</span>
          </div>
        {%- endif -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="mt-producto__miniaturas">
          {%- for media in product.media -%}
            <button type="button" class="mt-producto__mini {% if forloop.first %}mt-activa{% endif %}" data-mt-thumb data-full="{{ media | image_url: width: 1200 }}">
              <img src="{{ media | image_url: width: 160 }}" alt="{{ media.alt | escape }}" loading="lazy" width="80" height="80">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="mt-producto__compra">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mt-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="mt-h1 mt-producto__titulo">{{ product.title }}</h1>

      <div class="mt-producto__precio">
        <span class="mt-producto__precio-actual" data-mt-price>{{ product.selected_or_first_available_variant.price | money }}</span>
        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
          <span class="mt-producto__precio-anterior" data-mt-compare-price>{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
        {%- endif -%}
      </div>

      {% form 'product', product, class: 'mt-producto__form', id: 'mt-producto-form' %}
        <script type="application/json" data-mt-variants>{{ product.variants | json }}</script>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="mt-producto__opcion">
              <label class="mt-producto__opcion-label">{{ option.name }}</label>
              <div class="mt-producto__pills" data-mt-option="{{ option.position }}">
                {%- for value in option.values -%}
                  <button type="button" class="mt-producto__pill {% if value == option.selected_value %}mt-activa{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-mt-variant-id>

        <button
          type="submit"
          name="add"
          class="mt-btn mt-producto__boton"
          data-mt-add-button
          {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
          <span data-mt-add-text>
            {%- if product.selected_or_first_available_variant.available == false -%}
              {{ section.settings.boton_agotado }}
            {%- else -%}
              {{ section.settings.boton_texto }}
            {%- endif -%}
          </span>
        </button>
      {% endform %}

      <div class="mt-trust__row mt-producto__confianza">
        <div class="mt-trust__item">
          <span class="mt-trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="6" width="14" height="12"/><path d="M15 10h4l3 3v5h-7z"/><circle cx="6" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/></svg></span>
          <span class="mt-trust__label">{{ section.settings.confianza_1 }}</span>
        </div>
        <div class="mt-trust__item">
          <span class="mt-trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
          <span class="mt-trust__label">{{ section.settings.confianza_2 }}</span>
        </div>
        <div class="mt-trust__item">
          <span class="mt-trust__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 1 3 6.7"/><path d="M3 17v-5h5"/></svg></span>
          <span class="mt-trust__label">{{ section.settings.confianza_3 }}</span>
        </div>
      </div>

      {%- if section.settings.incluye != blank -%}
        <div class="mt-producto__incluye">
          <h3 class="mt-producto__subtitulo">{{ section.settings.incluye_titulo }}</h3>
          <ul class="mt-producto__lista">
            {%- assign mt_incluye_lineas = section.settings.incluye | newline_to_br | split: '<br />' -%}
            {%- for linea in mt_incluye_lineas -%}
              {%- if linea != blank -%}<li>{{ linea | strip }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.descripcion_intro != blank or product.description != blank -%}
    <div class="mt-container mt-producto__descripcion mt-reveal">
      {%- if section.settings.descripcion_intro != blank -%}
        <p class="mt-body mt-producto__intro">{{ section.settings.descripcion_intro }}</p>
      {%- endif -%}
      <div class="mt-body mt-producto__rich">{{ product.description }}</div>
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="mt-container mt-producto__caracteristicas mt-reveal mt-reveal-stagger">
      {%- for block in section.blocks -%}
        <div class="mt-pasos__card" {{ block.shopify_attributes }}>
          <h3 class="mt-pasos__title">{{ block.settings.titulo }}</h3>
          <p class="mt-body">{{ block.settings.texto }}</p>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "MT – Producto",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Trending" },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón comprar", "default": "Add to cart" },
    { "type": "text", "id": "boton_agotado", "label": "Texto cuando está agotado", "default": "Sold out" },
    { "type": "header", "content": "Fila de confianza" },
    { "type": "text", "id": "confianza_1", "label": "Texto 1", "default": "Shipping to the US, Canada & Mexico" },
    { "type": "text", "id": "confianza_2", "label": "Texto 2", "default": "100% secure payment" },
    { "type": "text", "id": "confianza_3", "label": "Texto 3", "default": "30-day guarantee" },
    { "type": "header", "content": "Qué incluye" },
    { "type": "text", "id": "incluye_titulo", "label": "Título del bloque", "default": "What's included" },
    { "type": "textarea", "id": "incluye", "label": "Un elemento por línea", "default": "1x producto principal\n1x manual rápido\nEmpaque protegido para envío internacional" },
    { "type": "header", "content": "Descripción" },
    { "type": "textarea", "id": "descripcion_intro", "label": "Frase de apertura de la descripción" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "caracteristica",
      "name": "Característica",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Proven quality" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Carefully selected materials so it lasts and works as expected." }
      ]
    }
  ],
  "presets": [ { "name": "MT – Producto" } ]
}
{% endschema %}
